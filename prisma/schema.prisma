generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  passwordHash      String
  intensity         String         @default("standard")
  customTargets     String?
  sportDays         String?
  onboarded         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  checkIns          CheckIn[]
  ownedCircles      Circle[]       @relation("OwnedCircles")
  circleMemberships CircleMember[]
}

model Circle {
  id         String         @id @default(cuid())
  name       String
  inviteCode String         @unique
  ownerId    String
  owner      User           @relation("OwnedCircles", fields: [ownerId], references: [id], onDelete: Cascade)
  members    CircleMember[]
  createdAt  DateTime       @default(now())
}

model CircleMember {
  id       String   @id @default(cuid())
  circleId String
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  exercise  Boolean  @default(false)
  study     Boolean  @default(false)
  apply     Int      @default(0)
  build     Boolean  @default(false)
  movement  Boolean  @default(false)
  noNap     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
