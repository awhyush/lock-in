generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  /// Null for accounts created via Google OAuth that have never set a password.
  passwordHash         String?
  intensity            String                @default("standard")
  customTargets        String?
  onboarded            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  checkIns             CheckIn[]
  goals                Goal[]
  ownedCircles         Circle[]              @relation("OwnedCircles")
  circleMemberships    CircleMember[]
  passwordResetTokens  PasswordResetToken[]
  nudgesSent           Nudge[]               @relation("NudgesSent")
  nudgesReceived       Nudge[]               @relation("NudgesReceived")
}

/** A single-use, short-lived token for the forgot-password flow. Only a hash of the token
 * is ever stored — the raw token exists only in the emailed link, so a DB leak alone can't
 * be used to take over an account. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/** type: "checkbox" (plain done/not-done), "duration" (target is minutes, still tracked as a
 * done/not-done toggle — mirrors the fixed-habit preset pattern), or "counter" (target is an
 * "aim for N" count, tracked as an actual running count — mirrors the "Work"/apply habit). */
model Goal {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  type      String      @default("checkbox")
  target    Int?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  entries   GoalEntry[]

  @@index([userId, sortOrder])
}

model GoalEntry {
  id     String  @id @default(cuid())
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId String
  date   String
  done   Boolean @default(false)
  count  Int     @default(0)

  @@unique([goalId, date])
  @@index([userId, date])
}

model Circle {
  id         String         @id @default(cuid())
  name       String
  inviteCode String         @unique
  ownerId    String
  owner      User           @relation("OwnedCircles", fields: [ownerId], references: [id], onDelete: Cascade)
  members    CircleMember[]
  nudges     Nudge[]
  createdAt  DateTime       @default(now())
}

/** A "hey, you're about to lose your streak" ping from one circle member to another. Only
 * ever creatable server-side when the recipient hasn't finished today's requirement AND
 * there are under NUDGE_WINDOW_HOURS left in the day (src/lib/nudges.ts) — never trusted
 * from the client. `date` + the unique constraint cap it at one nudge per pair per circle
 * per day. `seenAt` is set the moment the recipient's dashboard loads it, so it surfaces
 * as a banner exactly once. */
model Nudge {
  id         String    @id @default(cuid())
  circleId   String
  circle     Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User      @relation("NudgesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("NudgesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  date       String
  seenAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([circleId, fromUserId, toUserId, date])
  @@index([toUserId, date])
}

model CircleMember {
  id       String   @id @default(cuid())
  circleId String
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  /// JSON array of habit-key/goal-id strings this member has chosen to show in THIS circle.
  /// Null means "show everything" (the default — nobody's view changes until they narrow it).
  visibleKeys String?

  @@unique([circleId, userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  exercise  Boolean  @default(false)
  study     Boolean  @default(false)
  apply     Int      @default(0)
  build     Boolean  @default(false)
  movement  Boolean  @default(false)
  noNap     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
